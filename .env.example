# Copy this file to .env and fill in your values
# Only GROQ_API_KEY is needed for Week 1 (used in later weeks)

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama3-8b-8192

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=docqa

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5

# Tracing (optional — set to true to enable LangSmith)
LANGCHAIN_TRACING_V2=false

# Logging
LOG_LEVEL=INFO

# File limits
MAX_FILE_SIZE_MB=50
